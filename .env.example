# Server-Side Only Secrets (Do NOT prefix with VITE_ to prevent bundling into client-side JS)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Network Configuration (Defaults to 127.0.0.1 for secure local isolation)
PORT=3000
HOST=127.0.0.1

# Optional Client-Side Firebase App Check reCAPTCHA v3 Site Key
VITE_RECAPTCHA_SITE_KEY=
