rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all reads and writes across the entire database
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string))
        && (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string));
    }

    // User Profile Document Partitioning (Owner-Only Access)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Block user directory scraping entirely

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && isValidUserProfile(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false; // Prohibit destructive user drops via client SDK
    }
  }
}
